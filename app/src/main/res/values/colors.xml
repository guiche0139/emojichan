<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      两套色：① 语义色（背景/卡片/文字/分隔线……），深浅色各一份，值直接写在
      values/ 与 values-night/ 里，系统切深色就自动换；② 主题色调色板
      （palette_blue_* 与 palette_pink_* 各 8 个），由 values/themes.xml 里的
      ThemeOverlay.EmojiChan.<色> 挑一套套上去，运行时能换。

      主题色就两种，取自应用图标里的那对粉蓝：天空蓝 #99DFFF（默认）和樱花粉
      #FF99DF。这两个原色太淡 —— 浅色模式下拿来当 colorPrimary 会白字看不见、
      当文字也看不清 —— 所以浅色模式用同色相压深的版本（蓝 #1C7EA8 白字 4.6:1、
      粉 #C0438F 白字 4.7:1），深色模式才用原色本身配深墨字（10:1 上下）。

      语义色保持名字不变（别的布局都在用）；primary 那一组别名指向默认的蓝，
      真正要跟着主题色走的控件用 ?attr/colorPrimary 这类主题属性取色。
    -->
    <color name="primary">@color/palette_blue_primary</color>
    <color name="on_primary">@color/palette_blue_on_primary</color>
    <color name="primary_container">@color/palette_blue_primary_container</color>
    <color name="on_primary_container">@color/palette_blue_on_primary_container</color>

    <color name="secondary">@color/palette_blue_secondary</color>
    <color name="secondary_container">@color/palette_blue_secondary_container</color>
    <color name="on_secondary_container">@color/palette_blue_on_secondary_container</color>
    <color name="accent">#FFD166</color>

    <color name="background">#F5F6FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EEF0F7</color>
    <color name="text_primary">#1B1D2A</color>
    <color name="text_secondary">#6B7080</color>
    <color name="divider">#E7E9F0</color>

    <color name="success">#1FA971</color>
    <color name="warning">#E8A33D</color>
    <color name="warning_container">#FFF4E0</color>
    <color name="on_warning_container">#7A551A</color>
    <color name="danger">#E5484D</color>

    <!-- 状态条（无障碍服务未开启时的那条提示） -->
    <color name="status_on">#1FA971</color>
    <color name="status_off">#D98324</color>

    <!-- ==================== 主题色调色板（浅色） ==================== -->
    <!-- 天空蓝（默认）：主色 = 图标里那个蓝压深，次色 = 图标里的粉 -->
    <color name="palette_blue_primary">#1C7EA8</color>
    <color name="palette_blue_on_primary">#FFFFFF</color>
    <color name="palette_blue_primary_container">#D9F1FF</color>
    <color name="palette_blue_on_primary_container">#06344A</color>
    <color name="palette_blue_secondary">#C0438F</color>
    <color name="palette_blue_on_secondary">#FFFFFF</color>
    <color name="palette_blue_secondary_container">#FBE0F1</color>
    <color name="palette_blue_on_secondary_container">#4A0A2E</color>

    <!-- 樱花粉：主色 = 图标里那个粉压深，次色 = 图标里的蓝 -->
    <color name="palette_pink_primary">#C0438F</color>
    <color name="palette_pink_on_primary">#FFFFFF</color>
    <color name="palette_pink_primary_container">#FFE0F2</color>
    <color name="palette_pink_on_primary_container">#4A0A2E</color>
    <color name="palette_pink_secondary">#1C7EA8</color>
    <color name="palette_pink_on_secondary">#FFFFFF</color>
    <color name="palette_pink_secondary_container">#D9F1FF</color>
    <color name="palette_pink_on_secondary_container">#06344A</color>
</resources>
