<?xml version="1.0" encoding="utf-8"?>
<!--
  探测用无障碍服务配置。

  刻意保持最小能力：
    - 只订阅「换页面」事件（详细档会在运行时补上内容变化事件）
    - 不做手势（canPerformGestures=false），因为这一版完全不模拟操作
    - 白名单写在 packageNames 上，由系统在分发阶段过滤，不靠代码丢弃
  运行时还会用 setServiceInfo() 再设置一次，以便将来动态扩充白名单。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.tencent.mm,com.tencent.mobileqq"
    android:settingsActivity="com.aris.emojichan.sender.ChatProbeActivity" />
