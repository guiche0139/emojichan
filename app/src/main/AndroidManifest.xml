<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      图片一律通过系统的「选择图片」（ACTION_GET_CONTENT）拿，
      写相册走 MediaStore 自己的私有条目 —— 都不需要任何存储权限。
      emc-1-021：原来那句 READ_MEDIA_IMAGES 只会把导入卡死在 Android 14 的
      「仅选择的照片」上，删掉之后权限面板干净了，导入也不再问用户要权限。
    -->
    <!--
      「显示在其他应用上层」，悬浮球必需。
      它只能由用户在系统设置里手动打开（代码里用 Settings.canDrawOverlays 判断），
      这里声明只是为了让本应用出现在那张设置页的列表里。
      附带好处：持有该权限的应用不受 Android 10 起「后台启动 Activity」的限制，
      因此点表情后能直接把微信拉起来。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      相册读权限：**只为导入时问得出原文件名**（图片选择器只肯给 id 时，拿这个 id 去
      别处换回真名需要它）。用户点「允许读取相册」才申请，不授权也能正常导入 —— 那时
      走「从文件导入」或兜底名（emc-2-008）。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      Android 11 起的包可见性：不声明这一段，本应用就「看不到」微信 ——
      表现是只带 setPackage 的隐式分享 Intent 解析不到任何目标，直接抛
      ActivityNotFoundException，于是每次都退化成系统分享面板（用户实测的现象）。
      显式 ComponentName 不受这条限制，但组件名会随微信版本变，所以两头都要留着。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!--
          设置页「悬浮球出现在哪些应用」要列出所有带启动图标的应用。
          Android 11 起包可见性只看声明：不写这一条，queryIntentActivities(MAIN + LAUNCHER)
          一个都返回不了 —— 用户实测的现象就是那张列表空空如也（emc-2-011）。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          版本页的 GitHub 入口要把人送到发布页。包可见性只看声明：不写这一条，
          代码里 resolveActivity(VIEW + https) 永远返回 null —— 直接 startActivity 其实能用，
          但那样就没法在「没有浏览器」时给一句不一样的提示。
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:name=".EmojiChanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmojiChan">
        <!--
          launchMode=singleTop：本应用正开着时再分享进来不新建一个界面，
          只走 onNewIntent，导入完还停在原来那一页的栈上。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              出现在系统分享面板里：别的应用分享图片 / GIF 时能选「Emojichan」，直接收进表情库。
              只声明 image/*（含 image/gif），不去抢文档、音频那些分享。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name=".EmojiDetailActivity" />
        <activity android:name=".AdvancedSettingsActivity" />
        <activity android:name=".storage.StorageActivity" />
        <activity android:name=".storage.CompressActivity" />
        <activity android:name=".storage.CompressPreviewActivity" />
        <activity android:name=".storage.SearchActivity" />
        <activity
            android:name=".VersionActivity"
            android:label="@string/settings_version_title" />
        <!--
          初次进入的使用引导（v0.1.414）：讲清做什么 / 不做什么，再把人送到三个系统设置页
          （悬浮球要的「显示在其他应用上层」、无障碍、相册读权限）。不导出，只能从应用里进。
        -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title" />
        <activity
            android:name=".sender.SendLogActivity"
            android:exported="false"
            android:label="@string/log_title" />
        <!--
          场景感知 + 自动选中聊天对象用的无障碍服务。
          和白名单一样由系统在分发阶段过滤，平时不监听、不读屏：
          只在悬浮球被点开时读一次聊天页标题，分享后盯一小会儿「选择聊天」列表。
        -->
        <service
            android:name=".sender.AutoSendService"
            android:exported="true"
            android:label="@string/auto_send_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_send_service_config" />
        </service>
        <!--
          表情悬浮球。普通 Service 而非前台服务：不显示常驻通知。
          用户离开本应用后窗口要留在屏幕上，所以不能在 Activity 里挂。
        -->
        <service
            android:name=".sender.FloatingBallService"
            android:exported="false" />
        <!--
          下拉状态栏里的快捷开关（QS 磁贴）：点一下挂上 / 收起悬浮球。
          用户得在状态栏编辑面板里加一次，设置页那行负责引导（Android 13+ 能直接弹系统确认框）。
        -->
        <service
            android:name=".sender.BallTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--
          把 filesDir/emojis 下的图片以 content:// 形式分享给微信等外部应用。
          exported=false + grantUriPermissions=true：只在随 Intent / 剪贴板发放授权时可读，
          不做全局开放。
          用子类而不是 androidx 原版：每次外部取图都写一行流水（谁、按什么类型、取走多少），
          粘贴出问题时用来分清是「没人来取」还是「取走了但画成静图」。见 LoggingFileProvider。
        -->
        <provider
            android:name=".sender.LoggingFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
