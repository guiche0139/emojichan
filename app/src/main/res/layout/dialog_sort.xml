<?xml version="1.0" encoding="utf-8"?>
<!--
  排序选择（用户 m09998）：上面「按什么排」、下面「正序还是倒序」，两组单选。
  这里本来就是两个维度，写成一份单选列表说不清「名称 + 倒序」这种组合，所以自己摆布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sort_section_field"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/sortFieldGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/sortFieldTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_time" />

        <RadioButton
            android:id="@+id/sortFieldName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_name" />

        <RadioButton
            android:id="@+id/sortFieldSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_size" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sort_section_order"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/sortOrderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/sortOrderAsc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_order_asc" />

        <RadioButton
            android:id="@+id/sortOrderDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_order_desc" />
    </RadioGroup>
</LinearLayout>
