<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      两套色：① 语义色（背景/卡片/文字/分隔线……），深浅色各一份，值直接写在
      values/ 与 values-night/ 里，系统切深色就自动换；② 主题色调色板
      （palette_<色>_primary 等 6 个），由 values/themes.xml 里的
      ThemeOverlay.EmojiChan.<色> 挑一套套上去，运行时能换。
      语义色保持名字不变（别的布局都在用），primary 那一组是默认主题色（深蓝）的别名。
    -->
    <color name="primary">@color/palette_navy_primary</color>
    <color name="primary_light">#4A6FD0</color>
    <color name="primary_dark">#16295E</color>
    <color name="on_primary">@color/palette_on_primary</color>
    <color name="primary_container">@color/palette_navy_primary_container</color>
    <color name="on_primary_container">@color/palette_navy_on_primary_container</color>

    <color name="secondary">@color/palette_navy_secondary</color>
    <color name="secondary_container">@color/palette_navy_secondary_container</color>
    <color name="on_secondary_container">@color/palette_navy_on_secondary_container</color>
    <color name="accent">#FFD166</color>

    <color name="background">#F5F6FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EEF0F7</color>
    <color name="text_primary">#1B1D2A</color>
    <color name="text_secondary">#6B7080</color>
    <color name="divider">#E7E9F0</color>

    <color name="success">#1FA971</color>
    <color name="warning">#E8A33D</color>
    <color name="warning_container">#FFF4E0</color>
    <color name="on_warning_container">#7A551A</color>
    <color name="danger">#E5484D</color>

    <!-- 状态条（无障碍服务未开启时的那条提示） -->
    <color name="status_on">#1FA971</color>
    <color name="status_off">#D98324</color>

    <!-- ==================== 主题色调色板（浅色） ==================== -->
    <color name="palette_on_primary">#FFFFFF</color>

